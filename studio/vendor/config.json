{
  "embedding_backend": "sentence_transformers",
  "embedding_model": "sentence-transformers/all-MiniLM-L6-v2",
  "embedding_batch_size": 128,
  "embedding_device": "cpu",
  "target_passage_words": 75,
  "max_passage_words": 120,
  "max_passage_seconds": 45,
  "overlap_seconds": 12,
  "semantic_top_k": 300,
  "lexical_top_k": 260,
  "article_title_top_k": 110,
  "broad_candidate_pool": 180,
  "shortlist_per_step": 30,
  "max_passages_per_article": 5,
  "ai_candidates_per_step": 12,
  "output_alternatives": 3,
  "openai_enabled": true,
  "openai_model": "gpt-5-mini",
  "openai_max_concurrency": 3,
  "openai_timeout_seconds": 120,
  "openai_max_retries": 3,
  "learned_ranker_enabled": true,
  "learned_ranker_path": "learning_output/learned_ranker_v3_candidate.joblib",
  "confidence_calibration_path": "learning_output/confidence_calibration_v3_candidate.json",
  "reviewer_feedback_enabled": true,
  "reviewer_feedback_path": "feedback/reviewer_feedback_memory.json",
  "learned_signal_weight": 0.1,
  "reviewer_memory_weight": 0.12,
  "reviewer_memory_min_similarity": 0.72,
  "reviewer_memory_exact_similarity": 0.88,
  "context_relay_enabled": true,
  "relay_semantic_weight": 0.12,
  "protocol_semantic_weight": 0.08,
  "phase_semantic_weight": 0.05,
  "hard_constraint_weight": 0.08,
  "adjacent_article_boost": 0.07,
  "global_article_boost": 0.035,
  "continuity_min_local_score": 0.48,
  "continuity_top_articles_per_step": 10,
  "high_threshold": 0.74,
  "medium_threshold": 0.58,
  "low_threshold": 0.46,
  "minimum_visual_score": 50,
  "minimum_score_gap": 0.04,
  "include_unmapped_vtts": false,
  "store_openai_responses": false,
  "sequence_optimizer_enabled": true,
  "sequence_candidates_per_step": 8,
  "sequence_max_local_drop": 0.04,
  "sequence_min_candidate_score": 0.42,
  "source_coverage_min_score": 0.48,
  "sequence_source_coverage_weight": 0.05,
  "sequence_continuity_bonus": 0.07
